# Perfil agresivo local para corrida integral 150k+
# Copia este archivo a .env o exporta variables manualmente antes de ejecutar.

# --- Backend/DB ---
BASE_URL=http://backend:8000/api
USE_GUNICORN=1
GUNICORN_WORKERS=16

# Throttles altos para prueba de volumen (restaurar luego)
DRF_THROTTLE_ANON=12000/min
DRF_THROTTLE_USER=12000/min
DRF_THROTTLE_AUTH_LOGIN=6000/min
DRF_THROTTLE_AUTH_REFRESH=6000/min
DRF_THROTTLE_AUTH_LOGOUT=6000/min
DRF_THROTTLE_ME_READ=12000/min
DRF_THROTTLE_ME_ACL_READ=12000/min

# --- Auth load ---
AUTH_SIM_ADMIN_USERNAME=k6_admin
AUTH_SIM_ADMIN_PASSWORD=CHANGE_ME
AUTH_SIM_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
AUTH_SIM_USER_USERNAME=k6_user
AUTH_SIM_USER_PASSWORD=CHANGE_ME
CSRF_COOKIE_NAME=nt_csrf

# --- Operacional load ---
COMPANY_ID=1
BRANCH_ID=1
USERNAME=k6_operational
PASSWORD=CHANGE_ME
WAREHOUSE_ID=
ITEM_ID=

# --- Corrida ---
TOTAL_DURATION=15m
AUTH_VUS=120
AUTH_ADMIN_2FA_VUS=6
AUTH_ADMIN_2FA_SLEEP=1
OPER_BILLING_VUS=80
OPER_INVENTORY_VUS=80
OPER_POSTING_VUS=24

# Ejecuta gates de calidad/seguridad despues de carga
RUN_QA_GATES=1
RUN_SECURITY_SCAN=1
