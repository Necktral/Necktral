# --- Django PROD ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-aleatoria
DJANGO_JWT_SIGNING_KEY=pon-aqui-otra-clave-larga-aleatoria-para-jwt
DJANGO_ALLOWED_HOSTS=tu-dominio.com,tu-ip-lan

# Frontend en mismo origen (web) => http://tu-dominio
DJANGO_CORS_ALLOWED_ORIGINS=http://tu-dominio.com,http://tu-ip-lan
DJANGO_CSRF_TRUSTED_ORIGINS=http://tu-dominio.com,http://tu-ip-lan

# Auditoría contractual (HMAC fuerte)
AUDIT_HMAC_KEY=pon-aqui-una-clave-muy-larga-aleatoria
AUDIT_HMAC_KEYS=rot1:pon-aqui-una-clave-rot1,legacy:pon-aqui-una-clave-legacy

# Observabilidad (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# Bootstrap hardening
DJANGO_INITIAL_SETUP_TOKEN=pon-un-secreto-largo-aleatorio
DJANGO_INITIAL_SETUP_REQUIRE_TOKEN=1
DJANGO_INITIAL_SETUP_IP_ALLOWLIST=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16

# Alertas seguridad
SECURITY_ALERT_SLACK_WEBHOOK=

# Throttling (prod, estrictos)
DRF_THROTTLE_ANON=30/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_AUTH_REFRESH=30/min
DRF_THROTTLE_AUTH_LOGOUT=30/min
DRF_THROTTLE_AUTH_SENSITIVE=20/min
DRF_THROTTLE_ME_READ=120/min
DRF_THROTTLE_ME_ACL_READ=60/min
DRF_THROTTLE_BOOTSTRAP=5/hour

# --- Postgres ---
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=erpcrm_db
POSTGRES_USER=erpcrm_user
POSTGRES_PASSWORD=pon-un-password-fuerte
POSTGRES_HOST=db
POSTGRES_PORT=5432
